# Secrets
.cdsapirc
**/.cdsapirc

# Large generated / downloaded data (results live on workspace scratch, not here)
*.nc
*.grib
*.grib2
*.idx
*.npz
src/graphcast/data/

# Generated figures are regenerable, so the bulk (regional / global / drift / compare
# trees) stays out of git -- EXCEPT the curated deliverables: the case-study, the
# out-of-distribution results, and the heat-wave definition figures + GIFs.
outputs/*
!outputs/figures/
outputs/figures/*
!outputs/figures/case_study/
!outputs/figures/out_of_distribution/
!outputs/figures/heatwave2023/
!outputs/figures/heatwave2026/
# ...but not the GIFs (large; left out for now) -- keep only the static figures
outputs/figures/**/*.gif

# Python caches / editable-install / build artifacts
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# Virtualenvs. neural_gcm/ now holds ONLY the ML virtualenv + stray scratch
# outputs (no source lives there anymore), so ignore it wholesale.
.venv/
neural_gcm/

# Editor / agent config
.claude/
.idea/
default.jupyterlab-workspace

# Runtime logs
logs/
wget-log*

# Vendored GraphCast clone metadata backup
src/graphcast/source.git-backup/
